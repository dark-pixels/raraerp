{
  "db_name": "PostgreSQL",
  "query": "SELECT poi.id, poi.quantity, poi.received_quantity, poi.taxable_value, p.name\n               FROM purchase_order_items poi JOIN products p ON p.id = poi.product_id\n               WHERE poi.purchase_order_id = $1 AND poi.product_id = $2\n               ORDER BY poi.quantity - poi.received_quantity DESC LIMIT 1 FOR UPDATE OF poi",
