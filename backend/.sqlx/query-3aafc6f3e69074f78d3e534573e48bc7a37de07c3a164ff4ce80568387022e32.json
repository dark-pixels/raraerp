{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE refresh_tokens rt SET revoked_at = NOW()\n        FROM users u\n        WHERE u.id = rt.user_id\n          AND rt.token_hash = $1\n          AND rt.expires_at > NOW()\n          AND rt.revoked_at IS NULL\n        RETURNING rt.user_id, u.email, u.role, u.is_active\n        ",
