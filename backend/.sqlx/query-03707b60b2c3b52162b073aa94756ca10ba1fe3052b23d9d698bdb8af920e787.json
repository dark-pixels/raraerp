{
  "db_name": "PostgreSQL",
  "query": "SELECT ib.product_id, ib.on_hand, ib.available, ib.reserved, p.name AS product_name, p.sku, p.barcode\n           FROM inventory_balances ib\n           JOIN products p ON p.id = ib.product_id\n           WHERE ib.location_id = $1 AND ib.on_hand > 0\n           ORDER BY p.name",
