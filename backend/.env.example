# ─── RARA Enterprise ERP — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
# Comma-separated list of allowed browser origins, or * for any
FRONTEND_ORIGIN=http://localhost:5173

# ── Database (Aiven Cloud PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgres://username:password@hostname:port/dbname?sslmode=require
DB_MAX_CONNECTIONS=20

# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -hex 48`).
# If missing in production, a random key is generated per process and users are
# signed out whenever the server restarts.
JWT_SECRET=
JWT_EXPIRY_SECONDS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay (fill when ready) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── GST API (fill when credentials are provided) ─────────────────────────────
GST_API_BASE_URL=
GST_API_KEY=

# ── UPI Payments ─────────────────────────────────────────────────────────────
UPI_MERCHANT_ID=yourshop@upi
UPI_MERCHANT_NAME=RARA Enterprise

# ── Notifications ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@raraenterprise.com

# ── Scheduled jobs ────────────────────────────────────────────────────────────
# Enables GET /api/v1/cron/run (overdue marking, payment reminders, low-stock alerts).
# Call it on a schedule with header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=rara_erp_backend=debug,tower_http=info
TZ=Asia/Kolkata
